# SQLite database. Use an absolute path in a production container.
SERVICE_DB_PATH=data/service.sqlite3
SERVICE_ENV=production

# URL of the external service used for authentication and synchronization.
SERVICE_BASE_URL=https://service.example.com

# Stable Fernet key, generated once with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SERVICE_SESSION_ENCRYPTION_KEY=replace-with-a-stable-fernet-key

# Browser settings for Playwright authentication and scraping.
SERVICE_HEADLESS=1
SERVICE_SYNC_TIMEOUT_SECONDS=300
SERVICE_AUTH_CHALLENGE_TTL_SECONDS=300
SERVICE_AUTH_REQUESTS_PER_10_MINUTES=3
SERVICE_AUTH_MAX_ATTEMPTS=5
# Срок жизни Bearer-токена в секундах. По умолчанию 30 дней.
SERVICE_API_TOKEN_TTL_SECONDS=2592000
SERVICE_TIMEZONE=Europe/Moscow
# 0 = все чаты.
CHAT_AMOUNT_LIMIT=20
# 0 = все сообщения в каждом чате.
MESSAGE_AMOUNT_LIMIT=50
# Максимальное время ожидания SQLite-блокировки в секундах.
SERVICE_SQLITE_TIMEOUT_SECONDS=30
# SERVICE_MESSAGE_SELECTOR=[data-message-id]
# SERVICE_CHAT_ITEM_SELECTOR=[data-chat-id]
# SERVICE_DEBUG_ARTIFACTS=1

# Local-only API test mode. Never enable it in production.
# SERVICE_TEST_MODE=1
# SERVICE_TEST_SMS_CODE=1234
# SERVICE_SYNC_FIXTURE_PATH=data/messages.jsonl
